    "description": "A game world toy.",
    "license": "MIT",
    "engines": {
        "npm": ">=11.19.1",
        "node": ">=24.14.0"
    },
    "devDependencies": {
        "express": "5.2.1",
        "express-session": "1.19.0",
        "memorystore": "1.6.8",
        "ws" : "8.21.3",
        "pino": "10.3.1",
        "json5": "2.2.3",
        "sonic-boom": "5.0.1",
        "sass": "^1.104",
        "@eslint/js": "^9.39.1",
        "eslint": "^9.39.0",
        "globals": "^16.5.0",
        "google-closure-compiler": "^20240317.0.0"
    },
    "optionalDependencies": {
        "google-closure-compiler-osx": "^20240317.0.0"
    },
    "scripts": {
        "server-start": "node ./js/orb/server/Start.js",
        "server-start-debug": "node  --inspect-brk ./js/orb/server/Start.js",
        "server-stop": "pkill -15 node",
        "server-restart": "pkill -SIGHUP node",
        "build-client": "./bin/build ./js/orb/client/manifest.js ./lib/ouroboros-client.js ./js/orb/client true true orb.all"
