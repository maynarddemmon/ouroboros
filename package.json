{
    "name": "Ouroboros",
    "version": "1.0",
    "author": "Maynard Demmon",
    "description": "A game world toy.",
    "license": "MIT",
    "engines": {
        "npm": ">=10.8.2",
        "node": ">=22.5.1"
    },
    "dependencies": {
        "express": "4.19.2",
        "express-session": "1.18.0",
        "ws" : "8.18.0",
        "pino": "9.3.1",
        "json5": "2.2.3"
    },
    "devDependencies": {
        "google-closure-compiler": "^20230802.0.0"
    },
    "scripts": {
        "server-start": "node ./js/orb/server/Start.js",
        "server-start-debug": "node  --inspect-brk ./js/orb/server/Start.js",
        "server-stop": "pkill -15 node",
        "build-client": "./bin/build ./js/orb/client/manifest.js ./lib/ouroboros-client.js ./js/orb/client true true orb.all && stat -f%z ./lib/ouroboros-client.min.js"
    }
}
